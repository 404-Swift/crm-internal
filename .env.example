# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Sheets Configuration
# Get the ID from your Google Sheets URL: https://docs.google.com/spreadsheets/d/[ID]/edit
VITE_GOOGLE_SHEETS_ID=your_google_sheets_id

# Google Sheets API Key (for read operations)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key

# Google Sheets OAuth2 Configuration
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_SHEETS_CLIENT_ID=your_google_oauth_client_id
VITE_GOOGLE_SHEETS_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Note: Client secret is stored server-side in Supabase Edge Function, not here

# Supabase Functions URL (for OAuth token exchange)
# Format: https://[project-ref].supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=your_supabase_functions_url

# Legacy: OAuth2 Access Token (deprecated - use OAuth flow instead)
# VITE_GOOGLE_SHEETS_ACCESS_TOKEN=your_oauth2_access_token

# n8n Webhook (optional, for advanced workflows)
N8N_WEBHOOK_URL=your_n8n_webhook_url
